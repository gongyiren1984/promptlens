{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PromptLens",
  "version": "0.1.0",
  "identifier": "com.promptlens.desktop",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PromptLens 提示镜",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "dangerousDisableAssetCspModification": false
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "本地优先的提示词实验与评估工作台",
    "longDescription": "PromptLens 提示镜：在本机组织提示词、用例、模型与评分规则，运行可复现的多分支实验并生成可追溯报告。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../dist-sidecar/promptlens-sidecar": "promptlens-sidecar"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
